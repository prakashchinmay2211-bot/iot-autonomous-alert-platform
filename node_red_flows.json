[
  {
    "id": "tab_aidams_01",
    "type": "tab",
    "label": "Autonomous IoT Alert & Actuation",
    "disabled": false,
    "info": "Autonomous IoT Decision and Alert Management System (AIDAMS) Flow.\nListens to MQTT telemetry, executes rule-based thresholds, interfaces with ML API, and triggers autonomous actuators & Telegram/Webhook notifications."
  },
  {
    "id": "mqtt_broker_config",
    "type": "mqtt-broker",
    "name": "HiveMQ / Mosquitto Broker",
    "broker": "broker.hivemq.com",
    "port": "1883",
    "clientid": "nodered_aidams_client",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "birthTopic": "nodered/status",
    "birthQos": "0",
    "birthPayload": "{\"status\": \"online\"}",
    "birthMsg": {},
    "closeTopic": "nodered/status",
    "closeQos": "0",
    "closePayload": "{\"status\": \"offline\"}",
    "closeMsg": {},
    "willTopic": "nodered/status",
    "willQos": "0",
    "willPayload": "{\"status\": \"crash\"}",
    "willMsg": {},
    "userProps": "",
    "sessionExpiry": ""
  },
  {
    "id": "mqtt_in_telemetry",
    "type": "mqtt in",
    "z": "tab_aidams_01",
    "name": "Sub: iot/telemetry/machine_01",
    "topic": "iot/telemetry/machine_01",
    "qos": "1",
    "datatype": "auto-detect",
    "broker": "mqtt_broker_config",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 170,
    "y": 140,
    "wires": [
      [
        "fn_parse_and_validate"
      ]
    ]
  },
  {
    "id": "fn_parse_and_validate",
    "type": "function",
    "z": "tab_aidams_01",
    "name": "Parse & Evaluate Thresholds",
    "func": "var data = typeof msg.payload === 'string' ? JSON.parse(msg.payload) : msg.payload;\n\nmsg.telemetry = data;\nmsg.needsAction = false;\nmsg.actionType = 'NONE';\n\n// Decision Logic: Thermal Runaway Check\nif (data.temperature > 85.0) {\n    msg.needsAction = true;\n    msg.actionType = 'COOLING_OR_SHUTDOWN';\n    msg.alertLevel = 'CRITICAL';\n    msg.reason = 'Motor temperature exceeded 85°C safety limit';\n} \n// Bearing Degradation Check\nelse if (data.vibration > 4.5) {\n    msg.needsAction = true;\n    msg.actionType = 'THROTTLE';\n    msg.alertLevel = 'HIGH';\n    msg.reason = 'Bearing vibration spike detected (>4.5 mm/s)';\n}\n\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 420,
    "y": 140,
    "wires": [
      [
        "switch_action_needed"
      ]
    ]
  },
  {
    "id": "switch_action_needed",
    "type": "switch",
    "z": "tab_aidams_01",
    "name": "Action Required?",
    "property": "needsAction",
    "propertyType": "msg",
    "rules": [
      {
        "t": "true"
      },
      {
        "t": "else"
      }
    ],
    "checkall": "true",
    "repair": false,
    "outputs": 2,
    "x": 670,
    "y": 140,
    "wires": [
      [
        "fn_format_actuator_command",
        "fn_format_alert_notification"
      ],
      [
        "debug_normal_telemetry"
      ]
    ]
  },
  {
    "id": "fn_format_actuator_command",
    "type": "function",
    "z": "tab_aidams_01",
    "name": "Format Actuator Payload",
    "func": "var actPayload = {\n    timestamp: new Date().toISOString(),\n    target_device: msg.telemetry.device_id || 'PUMP_01',\n    command: msg.actionType,\n    reason: msg.reason,\n    source: 'NODE_RED_AUTONOMOUS_ENGINE'\n};\n\nif (msg.actionType === 'COOLING_OR_SHUTDOWN') {\n    actPayload.actuator = 'cooling_pump';\n    actPayload.state = 'FORCE_ON_100';\n    msg.topic = 'iot/actuator/cooling_pump';\n} else if (msg.actionType === 'THROTTLE') {\n    actPayload.actuator = 'rpm_limit';\n    actPayload.state = '50_PERCENT';\n    msg.topic = 'iot/actuator/rpm_limit';\n}\n\nmsg.payload = actPayload;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 930,
    "y": 100,
    "wires": [
      [
        "mqtt_out_actuator",
        "debug_actuator_out"
      ]
    ]
  },
  {
    "id": "mqtt_out_actuator",
    "type": "mqtt out",
    "z": "tab_aidams_01",
    "name": "Pub: iot/actuator/commands",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "mqtt_broker_config",
    "x": 1200,
    "y": 100,
    "wires": []
  },
  {
    "id": "fn_format_alert_notification",
    "type": "function",
    "z": "tab_aidams_01",
    "name": "Format Webhook / Alert",
    "func": "msg.payload = {\n    event: 'AUTONOMOUS_ALERT_TRIGGERED',\n    severity: msg.alertLevel,\n    message: msg.reason,\n    temperature: msg.telemetry.temperature,\n    vibration: msg.telemetry.vibration,\n    timestamp: new Date().toISOString()\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 930,
    "y": 180,
    "wires": [
      [
        "http_webhook_dispatch",
        "debug_alert_out"
      ]
    ]
  },
